# Data unique to the tablet: EFS holds the IMEI and radio calibration. Never in a repository.
backup/
tablet/backup/
*.img
*.tar
*.tar.md5

# Proprietary or third-party files, extracted from your own tablet
vendor/
tablet/vendor/
*.bin
*.apk

# Build output
build/
tablet/build/
host/GalaxyNoteDisplay
__pycache__/
*.pyc
