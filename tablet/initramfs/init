#!/bin/busybox sh
# Tablet boot on the Samsung 3.0 (RR) kernel: menu with external display, Android or recovery.
# The external display uses only busybox and notedisplayd, without Android.
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs dev /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mdev -s
mount -t tmpfs tmp /tmp

# Same kernel as Android: it is enough to put its ramdisk in place of ours and start its init.
# Android's /etc is a link, so our files move away first; from then on the applet links are no
# longer valid and busybox must be called by path.
boot_android() {
  /bin/busybox mkdir /.boot
  /bin/busybox mv /bin /sbin /usr /etc /var /lib /root /.boot/
  B=/.boot/bin/busybox
  $B zcat /android.cpio.gz | $B cpio -idmu 2>/dev/null
  $B rm -f /android.cpio.gz
  $B chown 0:0 /
  $B chmod 755 /
  $B umount /dev/pts /dev /tmp /sys /proc
  $B rmdir /tmp
  $B rm -rf /.boot
  exec /init
}

# The Samsung bootloader starts recovery while PARAM[0x700200] is 4 (REBOOT_MODE_RECOVERY):
# from recovery it goes back to 0, so the next reboot returns to the BOOT partition
if grep -q bootmode=2 /proc/cmdline; then
  printf '\000' | dd of=/dev/mmcblk0p4 bs=1 seek=$((0x700200)) count=1 conv=notrunc 2>/dev/null
  sync
fi

# In this mode the bootloader started because the cable was plugged into a powered-off tablet
[ "$(cat /sys/class/power_supply/battery/batt_lp_charging 2>/dev/null)" = 1 ] && boot_android

# Most recent menu choice: it lives in the last block of the BOOT partition, past the end of
# the image, where nothing else writes and the bootloader does not read. If missing, the
# external display. Written only when it changes. Recovery is not remembered, otherwise after
# a visit to TWRP every reboot would go back there.
BOOT=/dev/mmcblk0p5
LAST_BLOCK=4095		# 8 MB partition, 2048-byte blocks
last=0
[ "$(dd if=$BOOT bs=2048 skip=$LAST_BLOCK count=1 2>/dev/null | head -c 8)" = NDBOOT=1 ] && last=1
bootmenu $last
choice=$?
if [ $choice != 2 ] && [ $choice != $last ]; then
  printf "NDBOOT=$choice" | dd of=$BOOT bs=2048 seek=$LAST_BLOCK conv=sync,notrunc 2>/dev/null
  sync
fi

case $choice in
  1) boot_android ;;
  2) bootmenu recovery ;;
esac

echo /sbin/mdev > /proc/sys/kernel/hotplug

# MFC firmware: the driver requests it during kernel boot, before we run, so mdev does not
# see the event. It is loaded by hand as soon as the request appears in sysfs.
(
  # on kernel 3.0 the folder has the device name: the requested file is in uevent
  for i in $(seq 120); do
    for F in /sys/class/firmware/*; do
      [ -e "$F/loading" ] || continue
      N=$(sed -n 's/^FIRMWARE=//p' "$F/uevent")
      [ -f "/lib/firmware/$N" ] || continue
      echo 1 > "$F/loading"; cat "/lib/firmware/$N" > "$F/data"; echo 0 > "$F/loading"
      echo "firmware $N loaded into $F" >> /tmp/fw.log
    done
    [ -s /tmp/fw.log ] && break
    sleep 0.5
  done
) &

# Safety net: if notedisplayd dies, normal reboot. The Samsung kernel marks a "normal boot"
# and the bootloader goes back to the BOOT partition.
(sleep 60; while pidof notedisplayd > /dev/null; do sleep 10; done; reboot -f) &

# USB: Android accessory already active (18d1:2d00, interface 0 = accessory, as after the AOA
# switch) plus RNDIS network for telnet. The GalaxyNoteDisplay host finds it without a switch.
U=/sys/class/android_usb/android0
echo 0 > $U/enable
echo 18d1 > $U/idVendor
echo 2d00 > $U/idProduct
echo NoteDisplay > $U/iManufacturer
echo NoteDisplay > $U/iProduct
echo accessory,rndis > $U/functions
echo 1 > $U/enable
sleep 2
IF=$(ls /sys/class/net | grep -E "rndis|usb" | head -n1)
ifconfig $IF 172.16.42.1 netmask 255.255.255.0 up
cat > /etc/udhcpd.conf <<EOC
start 172.16.42.2
end 172.16.42.2
interface $IF
option subnet 255.255.255.0
option lease 3600
EOC
touch /var/lib/misc/udhcpd.leases
udhcpd /etc/udhcpd.conf
telnetd -l /bin/sh

# Receive, decode and display the stream; statistics in /tmp/nd.log (readable over telnet)
notedisplayd > /tmp/nd.log 2>&1 &

while true; do sleep 3600; done
