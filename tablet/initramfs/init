#!/bin/busybox sh
# Avvio del tablet sul kernel Samsung 3.0 (RR): menu con display esterno, Android o recovery.
# Il display esterno usa solo busybox e notedisplayd, senza Android.
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs dev /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mdev -s
mount -t tmpfs tmp /tmp

# Stesso kernel di Android: basta rimettere il suo ramdisk al posto del nostro e avviare il suo
# init. /etc di Android è un link, quindi prima sposto i nostri file; da lì in poi i link delle
# applet non valgono più e busybox va chiamato per percorso.
boot_android() {
  /bin/busybox mkdir /.boot
  /bin/busybox mv /bin /sbin /usr /etc /var /lib /root /.boot/
  B=/.boot/bin/busybox
  $B zcat /android.cpio.gz | $B cpio -idmu 2>/dev/null
  $B rm -f /android.cpio.gz
  $B chown 0:0 /
  $B chmod 755 /
  $B umount /dev/pts /dev /tmp /sys /proc
  $B rmdir /tmp
  $B rm -rf /.boot
  exec /init
}

# Il bootloader Samsung avvia la recovery finché PARAM[0x700200] vale 4 (REBOOT_MODE_RECOVERY):
# dalla recovery lo riporto a 0, così il prossimo riavvio torna alla partizione BOOT
if grep -q bootmode=2 /proc/cmdline; then
  printf '\000' | dd of=/dev/mmcblk0p4 bs=1 seek=$((0x700200)) count=1 conv=notrunc 2>/dev/null
  sync
fi

# In questa modalità il bootloader si è avviato perché il cavo è stato collegato a tablet spento
[ "$(cat /sys/class/power_supply/battery/batt_lp_charging 2>/dev/null)" = 1 ] && boot_android

# Scelta più recente del menu: sta nell'ultimo blocco della partizione BOOT, oltre la fine
# dell'immagine, dove non scrive nessun altro e il bootloader non legge. Se manca è il display
# esterno. Si scrive solo se cambia. La recovery non si ricorda, altrimenti dopo una visita a
# TWRP ogni riavvio tornerebbe lì.
BOOT=/dev/mmcblk0p5
LAST_BLOCK=4095		# partizione da 8 MB, blocchi da 2048 byte
last=0
[ "$(dd if=$BOOT bs=2048 skip=$LAST_BLOCK count=1 2>/dev/null | head -c 8)" = NDBOOT=1 ] && last=1
bootmenu $last
choice=$?
if [ $choice != 2 ] && [ $choice != $last ]; then
  printf "NDBOOT=$choice" | dd of=$BOOT bs=2048 seek=$LAST_BLOCK conv=sync,notrunc 2>/dev/null
  sync
fi

case $choice in
  1) boot_android ;;
  2) bootmenu recovery ;;
esac

echo /sbin/mdev > /proc/sys/kernel/hotplug

# Firmware dell'MFC: il driver lo chiede durante l'avvio del kernel, prima di noi, quindi
# mdev non vede l'evento. Lo carico a mano appena compare la richiesta in sysfs.
(
  # sul kernel 3.0 la cartella porta il nome del dispositivo: il file richiesto sta in uevent
  for i in $(seq 120); do
    for F in /sys/class/firmware/*; do
      [ -e "$F/loading" ] || continue
      N=$(sed -n 's/^FIRMWARE=//p' "$F/uevent")
      [ -f "/lib/firmware/$N" ] || continue
      echo 1 > "$F/loading"; cat "/lib/firmware/$N" > "$F/data"; echo 0 > "$F/loading"
      echo "firmware $N caricato in $F" >> /tmp/fw.log
    done
    [ -s /tmp/fw.log ] && break
    sleep 0.5
  done
) &

# Rete di sicurezza: se notedisplayd muore, riavvio normale. Il kernel Samsung segna "avvio
# normale" e il bootloader torna ad Android invece di rientrare in questa recovery.
(sleep 60; while pidof notedisplayd > /dev/null; do sleep 10; done; reboot -f) &

# USB: accessorio Android già attivo (18d1:2d00, interfaccia 0 = accessorio, come dopo lo
# switch AOA) più rete RNDIS per telnet. L'host GalaxyNoteDisplay lo trova senza switch.
U=/sys/class/android_usb/android0
echo 0 > $U/enable
echo 18d1 > $U/idVendor
echo 2d00 > $U/idProduct
echo NoteDisplay > $U/iManufacturer
echo NoteDisplay > $U/iProduct
echo accessory,rndis > $U/functions
echo 1 > $U/enable
sleep 2
IF=$(ls /sys/class/net | grep -E "rndis|usb" | head -n1)
ifconfig $IF 172.16.42.1 netmask 255.255.255.0 up
cat > /etc/udhcpd.conf <<EOC
start 172.16.42.2
end 172.16.42.2
interface $IF
option subnet 255.255.255.0
option lease 3600
EOC
touch /var/lib/misc/udhcpd.leases
udhcpd /etc/udhcpd.conf
telnetd -l /bin/sh

# Ricezione, decodifica e visualizzazione dello stream; statistiche in /tmp/nd.log (leggibili da telnet)
notedisplayd > /tmp/nd.log 2>&1 &

while true; do sleep 3600; done
