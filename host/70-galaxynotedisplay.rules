# Galaxy Note 10.1 in modalità display esterno: accesso USB senza sudo e avvio del servizio
# utente dell'host. Il nome del prodotto lo distingue da altri dispositivi Android accessorio.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d00", ATTR{product}=="NoteDisplay", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="galaxynotedisplay.service"
